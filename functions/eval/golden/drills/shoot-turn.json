 "coaching_points": [
  "Warm up 2-3 minutes \u2014 light jog, leg swings, easy side-foot passes and gentle turns before striking at pace",
  "Stand at the spot cone with your BACK TO GOAL, facing the feeder \u2014 check your shoulder for the corner before the ball arrives",
  "Receive the feed and take ONE turning touch out of your feet to the turn cone \u2014 open your hips as you turn, don't let the ball stick",
  "Glance up at the corner gate between your turning touch and the strike; plant foot beside the ball, head still at contact",
  "One ball: after each strike jog in, collect it and dribble it back to the feeder \u2014 that jog is your rest",
  "Target: 6 of 10 strikes through a corner gate within 2 seconds of the turning touch \u2014 count out loud, alternate near and far post",
  "Lock the ankle and keep the striking knee over the ball to drive it low and protect the joint",
  "10 strikes per set, 4 sets; collecting the ball and returning it to the feeder is the rest",
  "Hit 8/10 \u2192 step back so you receive further out; miss 5 \u2192 widen the gate to clean up contact first"
 ],
 "variations": [
  "Weak foot only \u2014 a strong-foot finish counts as a miss",
  "Turn both ways \u2014 alternate opening onto your right and left every rep",
  "One-touch turn \u2014 turn and strike in a single motion, no settle touch"
 ],
