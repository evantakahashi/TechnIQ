 "coaching_points": [
  "Warm up \u2014 two minutes of light jogging, dynamic leg swings and easy two-touch passing before working at pace",
  "ONE ball only: the server feeds, you return first-time, then shuffle to the next cone \u2014 the shuffle is your reset",
  "Shuffle to the cone and be SET before the feed arrives \u2014 plant, then strike; never receive flat-footed",
  "Scan first \u2014 look up at the server for their body cue BEFORE the ball arrives, open your hips to the return line",
  "Inside of the foot, ankle locked, plant foot pointing at the server \u2014 cushion and redirect in one motion",
  "Beat the clock: receive-and-return inside 2 seconds under the server's pressure \u2014 that's game tempo",
  "Target: 8 of 10 returns arrive to the server's correct foot at pace; count them out loud",
  "10 reps per set, 4 sets \u2014 the walk back to the cone between shuffles is your rest; swap roles after each set",
  "Progression: server fires harder and quicker; regression: allow a small settling touch before the return"
 ],
 "variations": [
  "Weak foot only \u2014 every one-touch return with the weak foot",
  "Alternate feet \u2014 right foot at C1, left foot at C2 each rep"
 ],
