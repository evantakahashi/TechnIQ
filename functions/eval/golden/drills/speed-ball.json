 "coaching_points": [
  "Warm up 2-3 minutes \u2014 light jog, leg swings, and easy ball rolls before sprinting with the ball",
  "Explode off the start cone \u2014 first two touches are hard pushes to hit top speed fast",
  "Low hips into every cut; push off the outside foot and change direction sharply, don't drift the turn",
  "Eyes up between cones \u2014 glance ahead to the next cone the instant you finish a cut",
  "One ball: after passing through the exit gate, jog back to the ball and dribble to the start \u2014 that jog is your rest",
  "Target: complete each run through the gate in 6 seconds or less with no loss of control \u2014 time yourself",
  "Volume: 6 runs per set, 4 sets; collecting the ball and walking back is the rest between reps",
  "Progression: beat 6s cleanly on 5 of 6 \u2192 widen the cone stagger; lose control twice \u2192 slow the entry and rebuild speed",
  "Keep the ball within one step of your feet on cuts \u2014 a big touch that runs past a cone counts as a miss"
 ],
 "variations": [
  "Weak foot only \u2014 every touch and cut with the weak foot",
  "Outside-of-boot cuts \u2014 turn the ball with the outside of the foot at each cone",
  "Race mode \u2014 start on a partner's clap, sprint the whole course flat out"
 ],
